# Copy to .env.uat. This file is only used by the end-to-end UAT suite.
#
# It MUST point at a SEPARATE Supabase project from .env. The suite signs in,
# creates quotations and deactivates users; run against production it would put
# rubbish in front of real clients. e2e/uat-env.ts compares the project refs and
# refuses to start if they match.
#
# Vite reads this file when started with `--mode uat` (npm run dev:uat).

VITE_SUPABASE_URL=https://your-uat-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-uat-publishable-key

# Test users, created by hand in the UAT project beforehand. Agent A must
# report to the supervisor, and each agent needs its own Rate My Service links.
E2E_SUPER_ADMIN_EMAIL=uat-superadmin@example.com
E2E_SUPER_ADMIN_PASSWORD=
E2E_PRODUCT_DEV_EMAIL=uat-proddev@example.com
E2E_PRODUCT_DEV_PASSWORD=
E2E_SUPERVISOR_EMAIL=uat-supervisor@example.com
E2E_SUPERVISOR_PASSWORD=
E2E_AGENT_A_EMAIL=uat-agent-a@example.com
E2E_AGENT_A_PASSWORD=
E2E_AGENT_B_EMAIL=uat-agent-b@example.com
E2E_AGENT_B_PASSWORD=

# Optional: a deactivated profile, for the lock-out check.
E2E_DEACTIVATED_EMAIL=
E2E_DEACTIVATED_PASSWORD=
